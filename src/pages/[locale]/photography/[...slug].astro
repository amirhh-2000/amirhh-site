---
import { Image } from "astro:assets";
import { type CollectionEntry, getCollection } from "astro:content";
import PhotographyPurchase from "@/components/content/PhotographyPurchase.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { photographySlug } from "@/data/content";
import { locales, otherLocale, ui } from "@/i18n";
import Base from "@/layouts/Base.astro";
import type { Locale } from "@/types";
export async function getStaticPaths() {
	const all = await getCollection("photography");
	return all
		.filter((entry) => !entry.data.draft)
		.flatMap((entry) =>
			locales.map((locale) => ({
				params: { locale, slug: photographySlug(entry.id) },
				props: { entry, locale },
			})),
		);
}
const { entry, locale } = Astro.props as {
	entry: CollectionEntry<"photography">;
	locale: Locale;
};
const slug = photographySlug(entry.id);
const title = entry.data.title[locale];
const description = entry.data.description[locale];
---
<Base meta={{ title, description, locale, alternateHref: `/${otherLocale(locale)}/photography/${slug}/`, articleDate: entry.data.publishedAt.toISOString(), ogImage: entry.data.cover.src.src }}>
	<article><header class="mb-10"><p class="text-muted mb-2 text-xs"><FormattedDate date={entry.data.publishedAt} locale={locale} /></p><h1 class="text-accent-2 text-3xl font-semibold sm:text-4xl">{title}</h1><p class="text-muted mt-4">{description}</p></header>
		<div class="space-y-16">{entry.data.photos.map((photo) => <figure><Image src={photo.src} alt={photo.alt[locale]} widths={[640, 960, 1440]} sizes="(max-width: 768px) 100vw, 768px" class="h-auto w-full rounded-sm" loading="lazy" /><figcaption class="text-muted mt-4 text-sm">{photo.title && <strong class="text-global-text me-2">{photo.title[locale]}</strong>}{photo.caption && <p class="mt-1">{photo.caption[locale]}</p>}<dl class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs"><div><dt class="inline">{ui[locale].commercialUse}: </dt><dd class="inline">{ui[locale][photo.commercialUse]}</dd></div><div><dt class="inline">{ui[locale].highRes}: </dt><dd class="inline">{ui[locale][photo.highRes]}</dd></div></dl>{photo.purchase && <PhotographyPurchase locale={locale} {...photo.purchase} />}</figcaption></figure>)}</div>
	</article>
</Base>
