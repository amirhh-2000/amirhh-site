---
import { type CollectionEntry, getCollection } from "astro:content";
import PhotographyBreadcrumbs from "@/components/content/PhotographyBreadcrumbs.astro";
import PhotographyCard from "@/components/content/PhotographyCard.astro";
import { photographySlug, photoSlug } from "@/data/content";
import { locales, otherLocale, ui } from "@/i18n";
import Base from "@/layouts/Base.astro";
import type { Locale } from "@/types";

export async function getStaticPaths() {
	const all = await getCollection("photography");
	return all
		.filter((entry) => !entry.data.draft)
		.flatMap((entry) =>
			locales.map((locale) => ({
				params: { locale, slug: photographySlug(entry.id) },
				props: { entry, locale },
			})),
		);
}

const { entry, locale } = Astro.props as {
	entry: CollectionEntry<"photography">;
	locale: Locale;
};
const slug = photographySlug(entry.id);
const title = entry.data.title[locale];
const description = entry.data.description[locale];
const preview = entry.data.photos[0];
if (!preview) throw new Error(`Photography collection ${entry.id} has no photographs.`);
---

<Base
	meta={{
		title,
		description,
		locale,
		alternateHref: `/${otherLocale(locale)}/photography/${slug}/`,
		articleDate: entry.data.publishedAt.toISOString(),
		ogImage: preview.src.src,
	}}
>
	<article>
		<header class="mb-10">
			<PhotographyBreadcrumbs
				locale={locale}
				items={[
					{ label: ui[locale].photography, href: `/${locale}/photography/` },
					{ label: title },
				]}
			/>
			<h1 class="text-accent-2 text-3xl font-semibold sm:text-4xl">{title}</h1>
			<p class="text-muted mt-4">{description}</p>
			<p class="text-muted mt-3 text-xs">{ui[locale].photoCount(entry.data.photos.length)}</p>
		</header>
		<div class="grid grid-cols-2 gap-x-3 gap-y-8 sm:grid-cols-3 sm:gap-x-5 sm:gap-y-10">
			{
				entry.data.photos.map((photo, index) => (
					<PhotographyCard
						collectionTitle={title}
						photo={photo}
						photoIndex={index}
						locale={locale}
						collectionSlug={slug}
						photoSlug={photoSlug(photo.slug, index)}
					/>
				))
			}
		</div>
	</article>
</Base>
