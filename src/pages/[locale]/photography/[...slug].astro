---
import { Image } from "astro:assets";
import { type CollectionEntry, getCollection } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import { photographySlug, photoSlug } from "@/data/content";
import { locales, otherLocale } from "@/i18n";
import Base from "@/layouts/Base.astro";
import type { Locale } from "@/types";

export async function getStaticPaths() {
	const all = await getCollection("photography");
	return all
		.filter((entry) => !entry.data.draft)
		.flatMap((entry) =>
			locales.map((locale) => ({
				params: { locale, slug: photographySlug(entry.id) },
				props: { entry, locale },
			})),
		);
}

const { entry, locale } = Astro.props as {
	entry: CollectionEntry<"photography">;
	locale: Locale;
};
const slug = photographySlug(entry.id);
const title = entry.data.title[locale];
const description = entry.data.description[locale];
---

<Base
	meta={{
		title,
		description,
		locale,
		alternateHref: `/${otherLocale(locale)}/photography/${slug}/`,
		articleDate: entry.data.publishedAt.toISOString(),
		ogImage: entry.data.cover.src.src,
	}}
>
	<article>
		<header class="mb-10">
			<p class="text-muted mb-2 text-xs">
				<FormattedDate date={entry.data.publishedAt} locale={locale} />
			</p>
			<h1 class="text-accent-2 text-3xl font-semibold sm:text-4xl">{title}</h1>
			<p class="text-muted mt-4">{description}</p>
		</header>
		<div class="grid grid-cols-3 gap-2 sm:gap-4">
			{
				entry.data.photos.map((photo, index) => {
					const href = `/${locale}/photography/${slug}/${photoSlug(photo.slug, index)}/`;
					const alt = photo.alt?.[locale] ?? photo.title?.[locale] ?? `${title} ${index + 1}`;
					return (
						<a class="group block" href={href} aria-label={photo.title?.[locale] ?? alt}>
							<Image
								src={photo.src}
								alt={alt}
								widths={[320, 480, 720]}
								sizes="(max-width: 767px) 33vw, 240px"
								class="aspect-square w-full rounded-sm object-cover transition-opacity group-hover:opacity-85"
								loading="lazy"
							/>
						</a>
					);
				})
			}
		</div>
	</article>
</Base>
