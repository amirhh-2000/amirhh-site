---
import PhotographyCollectionCard from "@/components/content/PhotographyCollectionCard.astro";
import { getPhotography, photographySlug } from "@/data/content";
import { isLocale, locales, otherLocale, ui } from "@/i18n";
import Base from "@/layouts/Base.astro";
export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}
const value = Astro.params.locale;
if (!isLocale(value)) return Astro.redirect("/fa/photography/");
const locale = value;
const entries = await getPhotography();
---

<Base
	meta={{
		title: ui[locale].photography,
		description:
			locale === "fa" ? "مجموعه‌ای انتخاب‌شده از عکس‌ها." : "A curated selection of photographs.",
		locale,
		alternateHref: `/${otherLocale(locale)}/photography/`,
	}}
>
	<header class="mb-10"><h1 class="title">{ui[locale].photography}</h1></header>
	{
		entries.length > 0 ? (
			<div class="grid grid-cols-3 gap-x-2 gap-y-8 sm:gap-x-5 sm:gap-y-10">
				{entries.map((entry) => (
					<PhotographyCollectionCard
						entry={entry}
						locale={locale}
						slug={photographySlug(entry.id)}
					/>
				))}
			</div>
		) : (
			<p class="text-muted">{ui[locale].noItems}</p>
		)
	}
</Base>
