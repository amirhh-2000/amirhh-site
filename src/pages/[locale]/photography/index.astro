---
import PhotographyCard from "@/components/content/PhotographyCard.astro";
import { getPhotography, photographySlug, photoSlug } from "@/data/content";
import { isLocale, locales, otherLocale, ui } from "@/i18n";
import Base from "@/layouts/Base.astro";
export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}
const value = Astro.params.locale;
if (!isLocale(value)) return Astro.redirect("/fa/photography/");
const locale = value;
const entries = await getPhotography();
const photographs = entries.flatMap((entry) =>
	entry.data.photos.map((photo, index) => ({
		entry,
		photo,
		index,
		collectionSlug: photographySlug(entry.id),
		photoSlug: photoSlug(photo.slug, index),
	})),
);
---

<Base
	meta={{
		title: ui[locale].photography,
		description:
			locale === "fa" ? "مجموعه‌ای انتخاب‌شده از عکس‌ها." : "A curated selection of photographs.",
		locale,
		alternateHref: `/${otherLocale(locale)}/photography/`,
	}}
>
	<header class="mb-10"><h1 class="title">{ui[locale].photography}</h1></header>
	{
		photographs.length > 0 ? (
			<div class="grid grid-cols-3 gap-x-2 gap-y-8 sm:gap-x-5 sm:gap-y-10">
				{photographs.map(({ entry, photo, index, collectionSlug, photoSlug }) => (
					<PhotographyCard
						entry={entry}
						photo={photo}
						photoIndex={index}
						locale={locale}
						collectionSlug={collectionSlug}
						photoSlug={photoSlug}
					/>
				))}
			</div>
		) : (
			<p class="text-muted">{ui[locale].noItems}</p>
		)
	}
</Base>
