---
import { getPhotography, getPhotographyItems } from "@/data/content";
import { locales } from "@/i18n";

export async function getStaticPaths() {
	const items = getPhotographyItems(await getPhotography());
	return items.flatMap((item) =>
		locales.map((locale) => ({
			params: { collection: item.categorySlug, locale, photo: item.slug },
			props: { locale, slug: item.slug },
		})),
	);
}

return Astro.redirect(`/${Astro.props.locale}/photography/${Astro.props.slug}/`, 301);
---
