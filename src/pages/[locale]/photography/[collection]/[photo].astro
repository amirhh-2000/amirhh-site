---
import { Image } from "astro:assets";
import { type CollectionEntry, getCollection } from "astro:content";
import PhotographyBreadcrumbs from "@/components/content/PhotographyBreadcrumbs.astro";
import PhotographyPurchase from "@/components/content/PhotographyPurchase.astro";
import { photographySlug, photoSlug } from "@/data/content";
import { locales, otherLocale, ui } from "@/i18n";
import Base from "@/layouts/Base.astro";
import type { Locale } from "@/types";

export async function getStaticPaths() {
	const all = await getCollection("photography");
	return all
		.filter((entry) => !entry.data.draft)
		.flatMap((entry) =>
			entry.data.photos.flatMap((photo, photoIndex) =>
				locales.map((locale) => ({
					params: {
						locale,
						collection: photographySlug(entry.id),
						photo: photoSlug(photo.slug, photoIndex),
					},
					props: { entry, locale, photoIndex },
				})),
			),
		);
}

const { entry, locale, photoIndex } = Astro.props as {
	entry: CollectionEntry<"photography">;
	locale: Locale;
	photoIndex: number;
};
const collectionSlug = photographySlug(entry.id);
const photo = entry.data.photos.at(photoIndex);
if (!photo) throw new Error(`Photo ${photoIndex} does not exist in ${entry.id}.`);
const currentPhotoSlug = photoSlug(photo.slug, photoIndex);
const collectionTitle = entry.data.title[locale];
const title = photo.title?.[locale];
const alt = photo.alt?.[locale] ?? title ?? `${collectionTitle} ${photoIndex + 1}`;
const caption = photo.caption?.[locale];
const positionLabel = ui[locale].photoPosition(photoIndex + 1, entry.data.photos.length);
const previousIndex = photoIndex > 0 ? photoIndex - 1 : undefined;
const nextIndex = photoIndex < entry.data.photos.length - 1 ? photoIndex + 1 : undefined;
const previousUrl =
	previousIndex !== undefined
		? `/${locale}/photography/${collectionSlug}/${photoSlug(entry.data.photos[previousIndex]?.slug, previousIndex)}/`
		: undefined;
const nextUrl =
	nextIndex !== undefined
		? `/${locale}/photography/${collectionSlug}/${photoSlug(entry.data.photos[nextIndex]?.slug, nextIndex)}/`
		: undefined;
const purchase = photo.purchase;
const hasPurchase = Boolean(
	purchase && (locale === "fa" ? purchase.iranPaymentUrl : purchase.nowPaymentsUrl),
);
const detailWidths = [...new Set([640, 960, 1440, Math.min(photo.src.width, 1440)])]
	.filter((width) => width <= photo.src.width)
	.sort((a, b) => a - b);
---

<Base
	meta={{
		title: title ?? `${collectionTitle} · ${photoIndex + 1}`,
		description: caption ?? entry.data.description[locale],
		locale,
		alternateHref: `/${otherLocale(locale)}/photography/${collectionSlug}/${currentPhotoSlug}/`,
		articleDate: entry.data.publishedAt.toISOString(),
		ogImage: photo.src.src,
	}}
>
	<article>
		<header class="mb-6">
			<PhotographyBreadcrumbs
				locale={locale}
				items={[
					{ label: ui[locale].photography, href: `/${locale}/photography/` },
					{
						label: collectionTitle,
						href: `/${locale}/photography/${collectionSlug}/`,
					},
					{ label: title ?? positionLabel },
				]}
			/>
			<p class="text-muted text-xs font-medium tracking-wide">{positionLabel}</p>
			{
				title ? (
					<h1 class="text-accent-2 mt-5 text-3xl font-semibold sm:text-4xl">{title}</h1>
				) : (
					<h1 class="sr-only">
						{collectionTitle} {photoIndex + 1}
					</h1>
				)
			}
		</header>
		<figure>
			<div class="bg-muted/5 flex justify-center overflow-hidden rounded-sm">
				<Image
					src={photo.src}
					alt={alt}
					widths={detailWidths}
					sizes="(max-width: 768px) 100vw, 768px"
					class="h-auto max-h-[82vh] w-auto max-w-full object-contain"
				/>
			</div>
			<figcaption class="text-muted mt-4 text-sm">
				{caption && <p>{caption}</p>}
				<dl class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs">
					<div>
						<dt class="inline">{ui[locale].imageOrigin}:</dt>
						<dd class="inline">{ui[locale].imageProcesses[photo.process]}</dd>
					</div>
					{
						photo.commercialUse && (
							<div>
								<dt class="inline">{ui[locale].commercialUse}: </dt>
								<dd class="inline">{ui[locale][photo.commercialUse]}</dd>
							</div>
						)
					}
					{
						photo.highRes && (
							<div>
								<dt class="inline">{ui[locale].highRes}: </dt>
								<dd class="inline">{ui[locale][photo.highRes]}</dd>
							</div>
						)
					}
				</dl>
				{hasPurchase && <PhotographyPurchase locale={locale} {...purchase} />}
			</figcaption>
		</figure>
		{
			(previousUrl || nextUrl) && (
				<nav
					aria-label={
						locale === "fa" ? "پیمایش میان عکس‌های کالکشن" : "Collection photograph navigation"
					}
					class="border-muted/30 mt-8 grid grid-cols-2 border-t pt-5 text-sm"
				>
					{previousUrl && (
						<a class="cactus-link justify-self-start" href={previousUrl}>
							{ui[locale].previousPhoto}
						</a>
					)}
					{nextUrl && (
						<a class="cactus-link col-start-2 justify-self-end" href={nextUrl}>
							{ui[locale].nextPhoto}
						</a>
					)}
				</nav>
			)
		}
	</article>
</Base>
