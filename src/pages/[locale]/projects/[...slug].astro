---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { contentSlug, findTranslation } from "@/data/content";
import { ui } from "@/i18n";
import Base from "@/layouts/Base.astro";
import type { Locale } from "@/types";
export async function getStaticPaths() {
	const all = await getCollection("project");
	return all
		.filter((entry) => !entry.data.draft)
		.map((entry) => {
			const locale = entry.data.language;
			const translation = findTranslation(entry, all);
			return {
				params: { locale, slug: contentSlug(entry.id, locale) },
				props: {
					entry,
					alternateHref: translation
						? `/${translation.data.language}/projects/${contentSlug(translation.id, translation.data.language)}/`
						: undefined,
				},
			};
		});
}
const { entry, alternateHref } = Astro.props as {
	entry: CollectionEntry<"project">;
	alternateHref?: string;
};
const locale = entry.data.language as Locale;
const { Content } = await render(entry);
---
<Base meta={{ title: entry.data.name, description: entry.data.description, locale, alternateHref }}>
	<article><header class="mb-10"><div class="text-muted mb-2 flex gap-3 text-xs"><span>{entry.data.year}</span><span>{ui[locale].statuses[entry.data.status]}</span></div><h1 class="text-accent-2 text-3xl font-semibold sm:text-4xl">{entry.data.name}</h1><p class="text-muted mt-4 text-base">{entry.data.description}</p>
		<div class="mt-6 flex flex-wrap gap-4" dir="ltr">{entry.data.website && <a class="cactus-link" href={entry.data.website} rel="noreferrer" target="_blank">{ui[locale].website}</a>}{entry.data.repository && <a class="cactus-link" href={entry.data.repository} rel="noreferrer" target="_blank">{ui[locale].repository}</a>}</div></header>
		<div class="prose prose-cactus max-w-none"><Content /></div>
		{entry.data.technologies.length > 0 && <section class="border-muted/30 mt-12 border-t pt-6"><h2 class="mb-3 font-semibold">{ui[locale].technologies}</h2><p dir="ltr">{entry.data.technologies.join(" · ")}</p></section>}
	</article>
</Base>
