---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { findTranslation } from "@/data/content";
import { locales, ui } from "@/i18n";
import Base from "@/layouts/Base.astro";
export async function getStaticPaths() {
	const pages = await getCollection("page", ({ data }) => !data.draft);
	return locales.flatMap((locale) => {
		const entry = pages.find(
			(item) => item.data.language === locale && item.data.translationKey === "about",
		);
		if (!entry) return [];
		const translation = findTranslation(entry, pages);
		return [
			{
				params: { locale },
				props: {
					entry,
					alternateHref: translation ? `/${translation.data.language}/about/` : undefined,
				},
			},
		];
	});
}
const { entry, alternateHref } = Astro.props as {
	entry: CollectionEntry<"page">;
	alternateHref?: string;
};
const locale = entry.data.language;
const { Content } = await render(entry);
---
<Base meta={{ title: entry.data.title, description: entry.data.description, locale, alternateHref }}>
	<article><h1 class="title mb-10">{ui[locale].about}</h1><div class="prose prose-cactus max-w-none text-base"><Content /></div></article>
</Base>
