---
import { type CollectionEntry, getCollection, render } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import { contentSlug, findTranslation } from "@/data/content";
import { ui } from "@/i18n";
import Base from "@/layouts/Base.astro";
import type { Locale } from "@/types";

export async function getStaticPaths() {
	const all = await getCollection("writing");
	return all
		.filter((entry) => !entry.data.draft)
		.map((entry) => {
			const locale = entry.data.language;
			const translation = findTranslation(entry, all);
			return {
				params: { locale, slug: contentSlug(entry.id, locale) },
				props: {
					entry,
					alternateHref: translation
						? `/${translation.data.language}/writing/${contentSlug(translation.id, translation.data.language)}/`
						: undefined,
				},
			};
		});
}
const { entry, alternateHref } = Astro.props as {
	entry: CollectionEntry<"writing">;
	alternateHref?: string;
};
const locale = entry.data.language as Locale;
const { Content } = await render(entry);
---
<Base meta={{ title: entry.data.title, description: entry.data.description, locale, alternateHref, articleDate: entry.data.publishedAt.toISOString() }}>
	<article>
		<header class="mb-10"><p class="text-muted mb-2 text-xs"><FormattedDate date={entry.data.publishedAt} locale={locale} /> · {ui[locale].categories[entry.data.category]}</p><h1 class="text-accent-2 text-3xl font-semibold sm:text-4xl">{entry.data.title}</h1><p class="text-muted mt-4 text-base">{entry.data.description}</p></header>
		<div class="prose prose-cactus max-w-none"><Content /></div>
		{entry.data.tags.length > 0 && <footer class="border-muted/30 mt-12 border-t pt-6"><ul class="flex flex-wrap gap-3">{entry.data.tags.map((tag) => <li><a class="cactus-link text-sm" href={`/${locale}/tags/${encodeURIComponent(tag)}/`}>#{tag}</a></li>)}</ul></footer>}
	</article>
</Base>
