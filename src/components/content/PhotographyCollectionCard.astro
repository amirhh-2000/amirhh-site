---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { ui } from "@/i18n";
import type { Locale } from "@/types";

const { entry, locale, slug } = Astro.props as {
	entry: CollectionEntry<"photography">;
	locale: Locale;
	slug: string;
};
const title = entry.data.title[locale];
const icon = entry.data.icon;
---

<article class="min-w-0">
	<a
		class="group block"
		href={`/${locale}/photography/${slug}/`}
		aria-label={`${title} · ${ui[locale].photoCount(entry.data.photos.length)}`}
	>
		<div
			class="border-muted/30 bg-muted/5 flex aspect-square items-center justify-center overflow-hidden rounded-sm border transition duration-300 group-hover:border-current group-hover:bg-transparent"
		>
			{
				icon ? (
					<Image
						src={icon}
						alt=""
						widths={[240, 360, 480]}
						sizes="(max-width: 639px) 45vw, 240px"
						class="h-full w-full object-contain transition duration-300 group-hover:-translate-y-1 group-hover:scale-[1.02]"
						loading="lazy"
					/>
				) : (
					<span aria-hidden="true" class="text-accent-2 text-4xl font-semibold">
						{title.charAt(0)}
					</span>
				)
			}
		</div>
		<div class="mt-3 flex min-w-0 items-baseline justify-between gap-2">
			<h2 class="text-global-text truncate text-sm font-semibold">{title}</h2>
			<span class="text-muted shrink-0 text-[0.68rem]">
				{ui[locale].photoCount(entry.data.photos.length)}
			</span>
		</div>
	</a>
</article>
