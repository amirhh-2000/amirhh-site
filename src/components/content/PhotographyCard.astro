---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@/types";

type PhotographyEntry = CollectionEntry<"photography">;
type Photograph = PhotographyEntry["data"]["photos"][number];

const { collectionTitle, photo, photoIndex, locale, collectionSlug, photoSlug } = Astro.props as {
	collectionTitle: string;
	photo: Photograph;
	photoIndex: number;
	locale: Locale;
	collectionSlug: string;
	photoSlug: string;
};
const title = photo.title?.[locale];
const alt = photo.alt?.[locale] ?? title ?? `${collectionTitle} ${photoIndex + 1}`;
const cardWidths = [320, 480, 720].filter((width) => width <= photo.src.width);
if (cardWidths.length === 0) cardWidths.push(photo.src.width);
---

<article class="min-w-0">
	<a
		class="group block"
		href={`/${locale}/photography/${collectionSlug}/${photoSlug}/`}
		aria-label={title ?? alt}
	>
		<div class="bg-muted/10 overflow-hidden rounded-sm">
			<Image
				src={photo.src}
				alt={alt}
				widths={cardWidths}
				sizes="(max-width: 767px) 33vw, 240px"
				class="aspect-square w-full object-cover transition duration-300 group-hover:scale-[1.015] group-hover:opacity-90"
				loading="lazy"
			/>
		</div>
		{title && <h2 class="text-global-text mt-2 truncate text-xs font-medium">{title}</h2>}
	</a>
</article>
