---
import { Image } from "astro:assets";
import type { Photograph } from "@/data/content";
import type { Locale } from "@/types";

const { categoryTitle, categorySlug, photo, photoIndex, locale, photoSlug } = Astro.props as {
	categoryTitle: string;
	categorySlug: string;
	photo: Photograph;
	photoIndex: number;
	locale: Locale;
	photoSlug: string;
};
const title = photo.title?.[locale];
const alt = photo.alt?.[locale] ?? title ?? `${categoryTitle} ${photoIndex + 1}`;
const cardWidths = [320, 480, 720].filter((width) => width <= photo.src.width);
if (cardWidths.length === 0) cardWidths.push(photo.src.width);
---

<article class="min-w-0" data-photo-category={categorySlug}>
	<a class="group block" href={`/${locale}/photography/${photoSlug}/`} aria-label={title ?? alt}>
		<div class="bg-muted/10 overflow-hidden rounded-sm">
			<Image
				src={photo.src}
				alt={alt}
				widths={cardWidths}
				sizes="(max-width: 767px) 33vw, 240px"
				class="aspect-square w-full object-cover transition duration-300 group-hover:scale-[1.015] group-hover:opacity-90"
				loading="lazy"
			/>
		</div>
	</a>
	<div class="mt-2 text-xs">
		<a
			class="text-muted hover:text-global-text inline-block underline-offset-4 hover:underline"
			href={`/${locale}/photography/?category=${encodeURIComponent(categorySlug)}`}
		>
			{categoryTitle}
		</a>
	</div>
</article>
