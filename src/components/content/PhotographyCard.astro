---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import type { Locale } from "@/types";

const { entry, locale, slug } = Astro.props as {
	entry: CollectionEntry<"photography">;
	locale: Locale;
	slug: string;
};
---
<article>
	<a class="group block" href={`/${locale}/photography/${slug}/`}>
		<Image src={entry.data.cover.src} alt={entry.data.cover.alt[locale]} widths={[480, 720, 960]} sizes="(max-width: 768px) 100vw, 720px" class="aspect-[16/9] w-full rounded-sm object-cover transition-opacity group-hover:opacity-90" loading="lazy" />
		<div class="mt-3 flex items-baseline justify-between gap-4"><h3 class="text-accent-2 text-lg font-semibold group-hover:underline">{entry.data.title[locale]}</h3><FormattedDate class="text-muted shrink-0 text-xs" date={entry.data.publishedAt} locale={locale} /></div>
		<p class="text-muted mt-1">{entry.data.description[locale]}</p>
	</a>
</article>
