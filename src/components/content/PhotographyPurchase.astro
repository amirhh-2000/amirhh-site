---
import { ui } from "@/i18n";
import type { Locale } from "@/types";

const { locale, iranPaymentUrl, nowPaymentsUrl, telegramUrl } = Astro.props as {
	locale: Locale;
	iranPaymentUrl?: string;
	nowPaymentsUrl?: string;
	telegramUrl?: string;
};
const paymentUrl = locale === "fa" ? iranPaymentUrl : nowPaymentsUrl;
const paymentLabel = locale === "fa" ? ui.fa.payIran : ui.en.payCrypto;
---

<aside class="border-muted/40 mt-5 border-s ps-4 pt-4">
	<div class="flex flex-wrap gap-3">
		<a class="cactus-link text-sm" href={paymentUrl} rel="noopener noreferrer" target="_blank">
			{paymentLabel}
		</a>
	</div>
	<p class="text-muted mt-3 text-xs">{ui[locale].paymentDeliveryNote}</p>
	{
		telegramUrl && (
			<a
				class="cactus-link mt-3 inline-block text-xs"
				href={telegramUrl}
				rel="noopener noreferrer"
				target="_blank"
			>
				{ui[locale].contactTelegram}
			</a>
		)
	}
</aside>
