---
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";
import "@/styles/global.css";

const { alternateHref, articleDate, description, locale, noIndex, ogImage, title } =
	Astro.props as SiteMeta;
const site = siteConfig.languages[locale];
const siteTitle = title === site.title ? title : `${title} • ${site.title}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(ogImage || "/social-card.png", Astro.site).href;
const ogLocale = locale === "fa" ? "fa_IR" : "en_US";
---

<meta charset="utf-8" />
<meta content="width=device-width, initial-scale=1.0" name="viewport" />
<title>{siteTitle}</title>
<link href="/icon.svg" rel="icon" type="image/svg+xml" />
<link href="/manifest.webmanifest" rel="manifest" />
<link href={canonicalURL} rel="canonical" />
{alternateHref && <link href={new URL(alternateHref, Astro.site)} hreflang={locale === "fa" ? "en" : "fa"} rel="alternate" />}
<link href={new URL(`/${locale}/`, Astro.site)} hreflang={locale} rel="alternate" />
<meta content={description} name="description" />
<meta content={siteConfig.author} name="author" />
{noIndex && <meta content="noindex,nofollow" name="robots" />}
<meta content={articleDate ? "article" : "website"} property="og:type" />
<meta content={siteTitle} property="og:title" />
<meta content={description} property="og:description" />
<meta content={canonicalURL} property="og:url" />
<meta content={site.title} property="og:site_name" />
<meta content={ogLocale} property="og:locale" />
<meta content={socialImageURL} property="og:image" />
<meta content="summary_large_image" name="twitter:card" />
<meta content={siteTitle} name="twitter:title" />
<meta content={description} name="twitter:description" />
<meta content={socialImageURL} name="twitter:image" />
{articleDate && <meta content={articleDate} property="article:published_time" />}
<link href="/sitemap-index.xml" rel="sitemap" />
<link href={`/${locale}/rss.xml`} title={`${site.title} RSS`} rel="alternate" type="application/rss+xml" />
<link crossorigin="anonymous" href="https://fonts.googleapis.com" rel="preconnect" />
<link crossorigin="anonymous" href="https://fonts.gstatic.com" rel="preconnect" />
<link href="https://fonts.googleapis.com/css2?family=Estedad:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
<meta content={Astro.generator} name="generator" />
