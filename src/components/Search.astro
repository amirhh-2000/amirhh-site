---
import { ui } from "@/i18n";
import type { Locale } from "@/types";
import "@/styles/blocks/search.css";

const { locale } = Astro.props as { locale: Locale };
---
<script>
	if (!import.meta.env.DEV) requestIdleCallback(async () => import("@pagefind/component-ui"));
</script>
<pagefind-config baseUrl={`${import.meta.env.BASE_URL}`} bundle-path={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/pagefind/`}></pagefind-config>
<pagefind-modal-trigger id="search" class="ms-auto" lang={locale} aria-label={ui[locale].search} hide-shortcut compact>
	<span aria-hidden="true" class="search-fallback">
		<svg fill="none" height="28" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="28" xmlns="http://www.w3.org/2000/svg"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5"></path></svg>
	</span>
</pagefind-modal-trigger>
<pagefind-modal lang={locale}></pagefind-modal>
