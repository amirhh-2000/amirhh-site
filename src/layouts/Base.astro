---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
}
const { meta } = Astro.props;
---

<html class="scroll-smooth" lang={meta.locale} dir={meta.locale === "fa" ? "rtl" : "ltr"}>
	<head>
		<BaseHead {...meta} />
		<ThemeProvider />
	</head>
	<body class="bg-global-bg text-global-text mx-auto flex min-h-screen max-w-3xl flex-col px-4 pt-16 text-sm font-normal antialiased sm:px-8">
		<SkipLink locale={meta.locale} />
		<Header locale={meta.locale} alternateHref={meta.alternateHref} />
		<main class="flex-1" data-pagefind-body id="main"><slot /></main>
		<Footer locale={meta.locale} />
	</body>
</html>
